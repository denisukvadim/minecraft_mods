# PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/minecraftmods

# At least 32 characters. Rotating it invalidates every issued access token.
JWT_SECRET=change-me-please-this-must-be-at-least-32-characters
JWT_TTL_MINUTES=60

HOST=0.0.0.0
PORT=8080

# Comma-separated origins, or `*` for any origin.
CORS_ORIGINS=*

# Directory that holds the mod files. Relative paths are resolved against the
# working directory; the directory is created on startup when missing.
MODS_DIR=./data/mods
# Largest accepted upload, in bytes (default 128 MiB).
MODS_MAX_UPLOAD_BYTES=134217728

# Optional bootstrap administrator, created on first start when the email is
# absent. All three must be set together. Remove them once the account exists.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

RUST_LOG=info,tower_http=debug

# Optional: control the Minecraft container through Portainer. When URL and API
# key are set, /api/v1/server/{status,start,stop,restart,logs} become available
# (permission server:manage). Both values must be set together; without them
# those endpoints answer 503 and the rest of the API works as usual.
# PORTAINER_URL=https://portainer.local:9443
# PORTAINER_API_KEY=ptr_...
# Portainer environment (endpoint) that hosts the container.
# PORTAINER_ENDPOINT_ID=1
# Container name inside that environment.
# MC_CONTAINER=minecraft
# Set to false only for a self-signed certificate you cannot add as a CA.
# PORTAINER_VERIFY_TLS=true
# PORTAINER_TIMEOUT_SECS=15
